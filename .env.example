# Copy to .env or run: python -m x_mrr_banner setup
# setup writes .env and can sync CI secrets to your fork via `gh secret set`.

# --- App Store Connect (Team API key required for sales reports) ---
ASC_ISSUER_ID=
ASC_KEY_ID=
# PEM is loaded from a .p8 file you drop in the repo during setup (filename only).
# Contents are written into ASC_PRIVATE_KEY below / GitHub secret — do not commit *.p8
ASC_PRIVATE_KEY=
ASC_VENDOR_NUMBER=

# --- Google Play bulk reports (GCS pubsite_prod_* bucket) ---
# Raw JSON string (preferred) or local path for manual setups.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_REPORTS_BUCKET=pubsite_prod_rev_XXXXXXXX

# --- X (Twitter) OAuth 1.0a — only needed when upload_to_x: true ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- Gemini (local template generation only; not synced to GitHub by setup) ---
GEMINI_API_KEY=
